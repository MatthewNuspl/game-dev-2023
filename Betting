import pandas as pd
import numpy as np
from sklearn.linear_model import LogisticRegression

# -------------------------
# GENERAL UTILITIES
# -------------------------

def implied_prob(decimal_odds):
    return 1 / decimal_odds

def expected_value(prob, odds):
    return (prob * odds) - 1

def bet_size(prob, odds, bankroll, kelly_fraction=0.25):
    edge = (prob * odds) - 1
    if edge <= 0:
        return 0
    return bankroll * (edge / (odds - 1)) * kelly_fraction


# -------------------------
# DATA PREPARATION
# -------------------------

def prepare_nba_data(df):
    df = df.copy()
    df['home_win'] = (df['home_score'] > df['away_score']).astype(int)
    df['point_diff'] = df['home_score'] - df['away_score']
    df['home_adv'] = 1
    X = df[['home_adv', 'point_diff']]
    y = df['home_win']
    return X, y, df

def prepare_nhl_data(df):
    df = df.copy()
    df['home_win'] = (df['home_score'] > df['away_score']).astype(int)
    df['goal_diff'] = df['home_score'] - df['away_score']
    df['home_ice'] = 1
    X = df[['goal_diff', 'home_ice']]
    y = df['home_win']
    return X, y, df

def prepare_nfl_data(df):
    df = df.copy()
    df['home_win'] = (df['home_score'] > df['away_score']).astype(int)
    df['point_diff'] = df['home_score'] - df['away_score']
    df['total_points'] = df['home_score'] + df['away_score']
    df['home_field'] = 1
    X = df[['point_diff', 'total_points', 'home_field']]
    y = df['home_win']
    return X, y, df


# -------------------------
# MODEL TRAINING
# -------------------------

def train_model(X, y):
    model = LogisticRegression(max_iter=1000)
    model.fit(X, y)
    return model


# -------------------------
# RUN PIPELINE FOR A SPORT
# -------------------------

def run_sport_model(
    csv_path,
    sport_name,
    prep_function,
    bankroll=1000
):
    print(f"\n===== {sport_name.upper()} =====")

    df = pd.read_csv(csv_path)

    X, y, df = prep_function(df)
    model = train_model(X, y)

    df['model_prob'] = model.predict_proba(X)[:, 1]
    df['book_prob'] = implied_prob(df['home_odds'])
    df['EV'] = expected_value(df['model_prob'], df['home_odds'])

    df['bet_size'] = df.apply(
        lambda row: bet_size(
            row['model_prob'],
            row['home_odds'],
            bankroll
        ),
        axis=1
    )

    value_bets = df[df['EV'] > 0].copy()

    if value_bets.empty:
        print("No value bets found.")
    else:
        print(value_bets[
            ['date', 'home_team', 'away_team', 'home_odds', 'model_prob', 'EV', 'bet_size']
        ].sort_values(by='EV', ascending=False))

    return value_bets


# -------------------------
# MAIN EXECUTION
# -------------------------

if __name__ == "__main__":

    BANKROLL = 1000

    nba_bets = run_sport_model(
        csv_path="nba_games.csv",
        sport_name="NBA",
        prep_function=prepare_nba_data,
        bankroll=BANKROLL
    )

    nhl_bets = run_sport_model(
        csv_path="nhl_games.csv",
        sport_name="NHL",
        prep_function=prepare_nhl_data,
        bankroll=BANKROLL
    )

    nfl_bets = run_sport_model(
        csv_path="nfl_games.csv",
        sport_name="NFL",
        prep_function=prepare_nfl_data,
        bankroll=BANKROLL
    )
